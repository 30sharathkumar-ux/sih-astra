# Environment Variables for Harvest AgriTech Dashboard
# Copy this to .env.local and fill in your values.

# ── Supabase ─────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── FastAPI Backend URL ───────────────────────────────────────────────────────
# Local development (default when not set):
#   VITE_API_BASE_URL=http://127.0.0.1:8000
#
# Production (set this in Vercel → Project Settings → Environment Variables):
#   VITE_API_BASE_URL=https://<your-render-service>.onrender.com
#
# The weather API key is NOT needed here — it is handled server-side by
# the backend (Open-Meteo is free and keyless; no secret required).
VITE_API_BASE_URL=http://127.0.0.1:8000
