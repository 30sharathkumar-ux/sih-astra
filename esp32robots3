void setup() {
  Serial.begin(115200);

  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);

  pinMode(IN1, OUTPUT); pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT); pinMode(IN4, OUTPUT);

  // ESP32 Arduino core 3.x LEDC API
  ledcAttach(ENA, 1000, 8);
  ledcAttach(ENB, 1000, 8);

  dht.begin();

  soilServo.setPeriodHertz(50);
  soilServo.attach(SERVO_PIN, 500, 2400);
  soilServo.write(SERVO_HOME);

  stopRobot();

  WiFi.mode(WIFI_AP);
  WiFi.softAP(AP_SSID, AP_PASS);

  Serial.println();
  Serial.println("SMART FARM ROBOT");
  Serial.print("Wi-Fi: ");
  Serial.println(AP_SSID);
  Serial.print("Dashboard: http://");
  Serial.println(WiFi.softAPIP());

  server.on("/", dashboard);
  server.on("/api/status", statusAPI);
  server.on("/api/move", moveAPI);
  server.on("/api/soil", soilMeasureAPI);
  server.on("/api/servo", servoAPI);

  server.begin();
}

void loop() {
  server.handleClient();

  // Basic safety stop while moving forward.
  if (directionNow == "FORWARD" && distanceCM() < 25) {
    stopRobot();
    directionNow = "OBSTACLE";
  }

  delay(20);
}
